[Unit]
Description=Grab recording service
After=pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
ExecStart=/usr/bin/grabd
TimeoutStopSec=600
# Stop signals grabd only; it stops its ffmpeg children itself (SIGINT, so they
# finish their FLAC). With the default, ffmpeg got systemd's SIGTERM too and the
# second signal made it exit without writing the trailer.
KillMode=mixed
Restart=on-failure
# grabd exits with 75 when its file was replaced (package upgrade) and nothing
# is recording: start the new version.
SuccessExitStatus=75
RestartForceExitStatus=75

# Started on demand by the tray widget (D-Bus activation, org.grab.Recorder);
# `systemctl --user enable grabd` starts it at login instead.
[Install]
WantedBy=default.target
