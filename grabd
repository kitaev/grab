                             "grabd", "settings.json")
SETTINGS_DEFAULTS = {"folder": ""}


class SettingsError(Exception):
    pass


class Settings:
    """User settings, kept in SETTINGS_FILE: the recordings folder ("" for
    DEFAULT_OUTDIR)."""

    def __init__(self):
        self.values = dict(SETTINGS_DEFAULTS)
        try:
            with open(SETTINGS_FILE) as f:
                saved = json.load(f)
            for key, default in SETTINGS_DEFAULTS.items():
                if isinstance(saved.get(key), type(default)):
                    self.values[key] = saved[key]
        except (OSError, ValueError, AttributeError):
            pass

    @property
    def outdir(self):
        return self.values["folder"] or DEFAULT_OUTDIR

    def as_dict(self):
        return {**self.values, "default_folder": DEFAULT_OUTDIR}

    def update(self, changes):
        new = dict(self.values)
        for key, value in changes.items():
            if key not in SETTINGS_DEFAULTS:
                raise SettingsError(f"unknown setting: {key}")
            if not isinstance(value, type(SETTINGS_DEFAULTS[key])):
                raise SettingsError(f"wrong type for {key}")
            new[key] = value
        folder = os.path.expanduser(new["folder"].strip())
        if folder:
            if not os.path.isabs(folder):
                raise SettingsError("the folder must be an absolute path")
            folder = os.path.normpath(folder)
            if folder == DEFAULT_OUTDIR:
                folder = ""
        new["folder"] = folder
        outdir = folder or DEFAULT_OUTDIR
        try:
            os.makedirs(outdir, exist_ok=True)
        except OSError as e:
            raise SettingsError(f"can't create {outdir}: {e.strerror}")
        if not os.access(outdir, os.W_OK | os.X_OK):
            raise SettingsError(f"can't write to {outdir}")
        os.makedirs(os.path.dirname(SETTINGS_FILE), exist_ok=True)
        tmp = SETTINGS_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(new, f, indent=2, ensure_ascii=False)
            f.write("\n")
        os.replace(tmp, SETTINGS_FILE)
        self.values = new


