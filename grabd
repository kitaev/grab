# ------------------------------------------------------------------ helpers

async def run(*cmd):
    proc = await asyncio.create_subprocess_exec(
        *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
    out, _ = await proc.communicate()
    return proc.returncode, out.decode(errors="ignore")


async def pactl_json(kind):
    rc, out = await run("pactl", "-f", "json", "list", kind)
    try:
        return json.loads(out) if rc == 0 else []
    except ValueError:
        return []


async def probe(path):
    """{"duration": seconds, "tags": {lower-case key: value}} via ffprobe, or None."""
    rc, out = await run("ffprobe", "-v", "error", "-show_entries", "format=duration:format_tags",
                        "-of", "json", path)
    try:
        fmt = json.loads(out)["format"] if rc == 0 else None
    except (ValueError, KeyError):
        return None
    if fmt is None:
        return None
    try:
        dur = float(fmt.get("duration", 0))
    except ValueError:
        dur = 0.0
    return {"duration": dur, "tags": {k.lower(): v for k, v in fmt.get("tags", {}).items()}}


def probe_mutagen(path):
    """Like probe(), read directly with mutagen: a few milliseconds, no process."""
    f = mutagen.File(path)
    if f is None or f.info is None:
        return None
    tags = {}
    if isinstance(f.tags, ID3):                # MP3
        for frame in f.tags.values():
            if frame.FrameID == "TXXX":
                tags[frame.desc.lower()] = str(frame.text[0]) if frame.text else ""
            elif frame.FrameID == "TIT2":
                tags["title"] = str(frame.text[0])
            elif frame.FrameID == "TDRC":          # mutagen writes "2026-11-01 12:00:00"
                tags["date"] = re.sub(r"^(\d{4}-\d\d-\d\d) ", r"\1T", str(frame.text[0]))
    elif f.tags is not None:                   # FLAC: Vorbis comments
        tags = {k.lower(): v[0] for k, v in f.tags.items() if v}
    return {"duration": float(f.info.length or 0), "tags": tags}


async def tag_info(path):
    """probe() via mutagen when installed, else ffprobe."""
    if mutagen:
        try:
            # in a thread: a folder with thousands of MP3s must not stall grabd
            return await asyncio.to_thread(probe_mutagen, path)
        except Exception:
            pass
    return await probe(path)


async def duration(path):
    info = await tag_info(path)
    return info["duration"] if info else 0.0


def real_title(t):
    t = (t or "").strip().lower()
    return bool(t) and not re.match(GENERIC_RE, t)


def unwrap(d):
    return {k: (v.value if isinstance(v, Variant) else v) for k, v in d.items()}


# ---- metadata in tags

def tag_args(meta):
    """ffmpeg -metadata arguments for {"title", "app", "started", "input"}."""
    tags = {"title": meta.get("title"), "date": meta.get("started"), "grab": "1",
            "grab_app": meta.get("app"), "grab_input": meta.get("input")}
    return [a for k, v in tags.items() if v for a in ("-metadata", f"{k}={v}")]


async def discard(paths, permanently=False):
    """Move files to the Trash, or delete them permanently; returns an error
    message or ""."""
    if not paths:
        return ""
    if not permanently:
        rc, _ = await run("gio", "trash", "--", *paths)
        return "" if rc == 0 else "could not move the files to the Trash"
    try:
        for path in paths:
            os.remove(path)
    except OSError as e:
        return f"could not delete the files: {e.strerror}"
    return ""


_tag_cache = {}                            # path -> ((mtime_ns, size), meta or None)


async def read_tags(path):
    """The recording's metadata from its tags ({"title", "app", "started",
    "input", "duration"}), or None if it isn't marked as ours. Cached until the
    file changes."""
    try:
        st = os.stat(path)
    except OSError:
        _tag_cache.pop(path, None)
        return None
    key = (st.st_mtime_ns, st.st_size)
    cached = _tag_cache.get(path)
    if cached and cached[0] == key:
        return cached[1]
    info = await tag_info(path)
    tags = info["tags"] if info else {}
    meta = None
    if tags.get("grab") == "1":
        meta = {"title": tags.get("title", ""), "app": tags.get("grab_app", ""),
                "started": tags.get("date", ""), "input": tags.get("grab_input", ""),
                "duration": info["duration"]}
    _tag_cache[path] = (key, meta)
    return meta


async def unmark(mp3):
    """Strip our marker tag from an MP3: in place with mutagen, else a lossless
    copy that replaces it. True if done."""
    if mutagen:
        try:
            tags = ID3(mp3)
            tags.delall("TXXX:grab")
            tags.save()
            return True
        except Exception as e:
            print(f"grabd: mutagen could not update {mp3} ({e}); copying with ffmpeg", flush=True)
    tmp = os.path.join(os.path.dirname(mp3), "." + os.path.basename(mp3) + ".tmp.mp3")
    rc, _ = await run("ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", mp3,
                      "-map", "0", "-c", "copy", "-map_metadata", "0", "-metadata", "grab=", tmp)
    if rc != 0:
        if os.path.exists(tmp):
            os.remove(tmp)
        return False
    os.replace(tmp, mp3)
    return True


FNAME_BYTES = 200          # title part of file names: with the time stamp, " (n)" and
                           # ".<name>.mp3.tmp.mp3" it stays under the 255-byte limit


def fname(t):
    """The title as part of a file name: no path separators or control
    characters, at most 120 characters and FNAME_BYTES bytes (UTF-8: a
    Cyrillic letter takes 2 bytes, an emoji 4)."""
    t = re.sub(r"[/:\\\"'\x00-\x1f\x7f]", "_", t).strip()[:120]
    t = t.encode()[:FNAME_BYTES].decode(errors="ignore").strip()
    return t or "audio"


async def encode_snapshot(flac, mp3, meta):
    """flac -> mp3 tagged with meta, atomically replacing mp3.
    Returns (ok, saved, seconds)."""
    if not os.path.exists(flac):
        return True, False, 0.0
    tmp = os.path.join(os.path.dirname(mp3), "." + os.path.basename(mp3) + ".tmp.mp3")
    rc, _ = await run("ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", flac,
                      "-map_metadata", "-1", *tag_args(meta),
                      "-c:a", "libmp3lame", "-q:a", "0", tmp)
    if rc != 0:
        if os.path.exists(tmp):
            os.remove(tmp)
        return False, False, 0.0
    sec = await duration(tmp)
    if sec >= MIN_SEC:
        os.replace(tmp, mp3)
        return True, True, sec
    os.remove(tmp)
    return True, False, sec


async def node_ports():
    """{node_id: {"output": [(channel, port_id)], "input": [...]}} from pw-dump."""
    rc, out = await run("pw-dump")
    try:
        objs = json.loads(out)
    except ValueError:
        return {}
    nodes = {}
    for o in objs:
        if o.get("type") != "PipeWire:Interface:Port":
            continue
        info = o.get("info", {})
        props = info.get("props", {})
        if props.get("port.monitor") in (True, "true"):
            continue
        node = str(props.get("node.id"))
        nodes.setdefault(node, {"output": [], "input": []})
        d = info.get("direction")
        if d in ("output", "input"):
            nodes[node][d].append((props.get("audio.channel"), o["id"]))
    return nodes


async def pw_graph():
    """(nodes: {id: props}, links: [(out node, out port, in node, in port)]) from pw-dump."""
    rc, out = await run("pw-dump")
    try:
        objs = json.loads(out)
    except ValueError:
        return {}, []
    nodes = {str(o["id"]): o.get("info", {}).get("props", {})
             for o in objs if o.get("type") == "PipeWire:Interface:Node"}
    links = [tuple(str(o["info"][k]) for k in ("output-node-id", "output-port-id",
                                                "input-node-id", "input-port-id"))
             for o in objs if o.get("type") == "PipeWire:Interface:Link"]
    return nodes, links


async def monitor_ports(node):
    """[(channel, port id)] of a sink's monitor outputs (node_ports() skips them)."""
    rc, out = await run("pw-dump")
    try:
        objs = json.loads(out)
    except ValueError:
        return []
    return [(o["info"]["props"].get("audio.channel"), o["id"]) for o in objs
            if o.get("type") == "PipeWire:Interface:Port"
            and str(o["info"]["props"].get("node.id")) == str(node)
            and o["info"].get("direction") == "output"
            and o["info"]["props"].get("port.monitor") in (True, "true")]


async def stream_target(node):
    """The stream's "target.object" in the default metadata ("Play on"), or None."""
    rc, out = await run("pw-metadata", "-n", "default", node, "target.object")
    m = re.search(r"key:'target\.object' value:'([^']*)'", out)
    return m[1] if m else None


def route_ports(outs, ins, left, right):
    """Pairs (out port, in port) sending each source channel to the left or
    right one of the target channels: a single channel, mono or centre goes to
    both, LFE is dropped, names ending in L/R (FL, RL, SL, FLC, ...) go to that
    side, anything else (AUXn) alternates."""
    targets = {ch: pid for ch, pid in ins}
    pairs = []
    for idx, (ch, pid) in enumerate(outs):
        ch = (ch or "").upper()
        side = ch[:-1] if len(ch) > 2 and ch.endswith("C") else ch    # FLC -> FL
        if len(outs) == 1 or ch in ("MONO", "FC", "RC", "TC", "TFC", "TRC"):
            dst = (left, right)
        elif ch == "LFE":
            dst = ()
        elif side.endswith("L"):
            dst = (left,)
        elif side.endswith("R"):
            dst = (right,)
        else:
            dst = (left,) if idx % 2 == 0 else (right,)
        pairs += [(pid, targets[d]) for d in dst if d in targets]
    return pairs


# ------------------------------------------------------------------ model

class Stream:
    def __init__(self, si, player_title=""):
        p = si.get("properties", {})
        self.idx = si["index"]
        self.node = str(p.get("object.id"))
        self.media = p.get("media.name", "")
        self.app = p.get("application.name", "Audio")
        self.process = Stream.pid(si)
        self.corked = si.get("corked", False)
        self.player_title = player_title   # from the app's MPRIS player, if any

    @staticmethod
    def pid(si):
        return str(si.get("properties", {}).get("application.process.id", ""))

    @property
    def has_title(self):
        return real_title(self.media) or bool(self.player_title)

    @property
    def title(self):
        if real_title(self.media):
            return self.media.strip()
        return self.player_title or self.app

    @property
    def offerable(self):
        return not self.corked or self.has_title

    @staticmethod
    def accept(si):
        p = si.get("properties", {})
        if p.get("node.link-group"):
            return False
        if re.match(EXCLUDE_ROLE_RE, p.get("media.role", ""), re.I):
            return False
        if EXCLUDE_APP_RE and re.search(EXCLUDE_APP_RE, p.get("application.name", ""), re.I):
            return False
        return True


class Item:
    ids = itertools.count(1)
    # ids differ between grabd runs: a client holding an id from before a
    # restart (e.g. an open "Delete File?" dialog) must not hit another item
    run = os.urandom(4).hex()

    def __init__(self, stream=None, title="", app=""):
        self.id = f"{Item.run}-{next(Item.ids)}"
        self.stream = stream
        self.title = stream.title if stream else title
        self.app = stream.app if stream else app
        self.process = stream.process if stream else ""   # the app's process id
        self.state = "available"
        self.busy = False
        self.pending = False               # a Toggle is in progress
        self.muted = False                 # playback muted (SetPlaybackMuted)
        self.echo_cancel = True            # input through the echo canceller
        self.aec = None                    # the Aec the input is linked through
        self.silent_links = []             # stream -> grab_silent while muted
        self.playback_node = None          # the device it played on before muting
        self.input = ""                    # "" none, "default", or source name
        self.file = ""
        self.duration = 0.0
        self.error = ""
        self.started = ""                  # ISO time the recording started
        self.recorded = False              # recorded by this grabd (not found by a scan)
        self.lost = False                  # recording, its stream gone: waiting for a new one
        self.input_desc = ""               # input as recorded, if no longer known (recovered)
        # recording internals
        self.sink = ""
        self.sink_node = None
        self.module = None
        self.input_node = None             # source node the input is linked from now
        self.proc = None
        self.proc_stopping = False         # grabd is stopping proc (ffmpeg) itself
        self.ffmpeg_died = False           # proc exited on its own while recording
        self.flac = ""
        self.mp3 = ""
        self.stream_links = []
        self.input_links = []
        self.op = asyncio.Lock()

    def props(self, input_desc):
        return {
            "id": Variant("s", self.id),
            "title": Variant("s", self.title),
            "app": Variant("s", self.app),
            "state": Variant("s", self.state),
            "busy": Variant("b", self.busy),
            "pending": Variant("b", self.pending),
            "muted": Variant("b", self.muted),
            "echo_cancel": Variant("b", self.echo_cancel),
            "stream": Variant("b", self.stream is not None),
            "input": Variant("s", self.input),
            "input_description": Variant("s", input_desc),
            "file": Variant("s", self.file),
            "duration": Variant("d", float(self.duration)),
            "error": Variant("s", self.error),
        }


# ------------------------------------------------------------------ encoding queue

class EncodeQueue:
    """One worker for all items; requests are coalesced per item."""

    def __init__(self, on_done, tags_for):
        self.tags_for = tags_for           # item -> metadata to tag the MP3 with
        self.pending = {}                  # item -> final? (insertion ordered)
        self.current = None
        self.wake = asyncio.Event()
        self.idle = asyncio.Event()
        self.idle.set()
        self.on_done = on_done

    def request(self, item, final=False):
        self.pending[item] = self.pending.get(item, False) or final
        item.busy = True
        self.idle.clear()
        self.wake.set()

    async def drain(self):
        await self.idle.wait()

    async def worker(self):
        while True:
            await self.wake.wait()
            self.wake.clear()
            while self.pending:
                item, final = next(iter(self.pending.items()))
                del self.pending[item]
                self.current = item
                try:
                    ok, saved, sec = await encode_snapshot(item.flac, item.mp3,
                                                           self.tags_for(item))
                except Exception as e:     # keep the queue going (and drain() working)
                    print(f"grabd: encoding {item.flac} failed: {e!r}", flush=True)
                    ok, saved, sec = False, False, 0.0
                self.current = None
                item.busy = item in self.pending
                try:
                    await self.on_done(item, final, ok, saved, sec)
                except Exception as e:
                    print(f"grabd: after encoding {item.flac}: {e!r}", flush=True)
            self.idle.set()


# ------------------------------------------------------------------ MPRIS titles

class Players:
    """Track titles from MPRIS media players, keyed by process id, for streams
    whose media.name is generic (e.g. VLC's "audio stream")."""

    def __init__(self, bus, on_change):
        self.bus = bus
        self.on_change = on_change
        self.players = {}                  # bus name -> {"owner", "pid", "status", "title"}

    async def _call(self, dest, path, iface, member, sig="", body=()):
        reply = await self.bus.call(Message(destination=dest, path=path, interface=iface,
                                            member=member, signature=sig, body=list(body)))
        if reply.message_type == MessageType.ERROR:
            raise RuntimeError(reply.error_name)
        return reply.body

    async def _dbus(self, member, sig="", body=()):
        return await self._call("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                "org.freedesktop.DBus", member, sig, body)

    async def start(self):
        for rule in (
                f"type='signal',sender='org.freedesktop.DBus',member='NameOwnerChanged',"
                f"arg0namespace='{MPRIS_PREFIX}'",
                f"type='signal',interface='org.freedesktop.DBus.Properties',"
                f"member='PropertiesChanged',path='{MPRIS_PATH}',arg0='{MPRIS_PLAYER}'"):
            await self._dbus("AddMatch", "s", [rule])
        self.bus.add_message_handler(self._on_message)
        (names,) = await self._dbus("ListNames")
        for name in names:
            if name.startswith(MPRIS_PREFIX + "."):
                await self._update(name)
        self.on_change()

    def _on_message(self, msg):
        if msg.message_type != MessageType.SIGNAL:
            return None
        loop = asyncio.get_running_loop()
        if msg.member == "NameOwnerChanged" and msg.sender == "org.freedesktop.DBus":
            name, _old, new = msg.body
            if name.startswith(MPRIS_PREFIX + "."):
                if new:
                    loop.create_task(self._update(name, notify=True))
                elif self.players.pop(name, None):
                    self.on_change()
        elif msg.member == "PropertiesChanged" and msg.path == MPRIS_PATH:
            for name, p in list(self.players.items()):
                if p["owner"] == msg.sender:
                    loop.create_task(self._update(name, notify=True))
        return None

    async def _update(self, name, notify=False):
        try:
            (owner,) = await self._dbus("GetNameOwner", "s", [name])
            (pid,) = await self._dbus("GetConnectionUnixProcessID", "s", [name])
            props = "org.freedesktop.DBus.Properties"
            (meta,) = await self._call(name, MPRIS_PATH, props, "Get", "ss",
                                       [MPRIS_PLAYER, "Metadata"])
            (status,) = await self._call(name, MPRIS_PATH, props, "Get", "ss",
                                         [MPRIS_PLAYER, "PlaybackStatus"])
        except Exception:
            self.players.pop(name, None)
        else:
            self.players[name] = {"owner": owner, "pid": str(pid), "status": status.value,
                                  "title": self._title(unwrap(meta.value))}
        if notify:
            self.on_change()

    @staticmethod
    def _title(meta):
        title = (meta.get("xesam:title") or "").strip()
        if not title and meta.get("xesam:url"):
            path = urllib.parse.urlparse(meta["xesam:url"]).path
            title = os.path.splitext(urllib.parse.unquote(os.path.basename(path)))[0]
            title = re.sub(TIMESTAMP_RE, "", title)
        artist = ", ".join(a for a in meta.get("xesam:artist") or [] if a.strip())
        if title and artist and artist.lower() not in title.lower():
            title = f"{artist} - {title}"
        return title

    def title_for(self, pid):
        """Title of the process's player; prefer one that is playing."""
        found = [p for p in self.players.values() if p["pid"] == pid and p["title"]]
        found.sort(key=lambda p: p["status"] != "Playing")
        return found[0]["title"] if found else ""


# ------------------------------------------------------------------ echo cancellation

class Aec:
    """PipeWire's echo canceller for one input and one output, in its own
    "pipewire -c" process; hidden nodes, linked by grabd."""
    serial = itertools.count(1)

    def __init__(self, mic_node, spk_node):
        self.mic_node, self.spk_node = mic_node, spk_node
        n = next(Aec.serial)
        self.names = {k: f"grab_aec_{n}_{k}" for k in ("capture", "ref", "source")}
        self.conf = os.path.join(RUNTIME_DIR, f"aec_{os.getpid()}_{n}.conf")
        self.proc, self.source = None, None
        self.users = set()                 # items using it

    async def start(self, rec):
        os.makedirs(RUNTIME_DIR, exist_ok=True)
        hidden = "state.restore-props = false state.restore-target = false"
        with open(self.conf, "w") as f:
            f.write(f"""
context.properties = {{ log.level = 1 }}
context.spa-libs = {{ audio.convert.* = audioconvert/libspa-audioconvert  support.* = support/libspa-support }}
context.modules = [
  {{ name = libpipewire-module-rt args = {{ }} flags = [ ifexists nofail ] }}
  {{ name = libpipewire-module-protocol-native }}
  {{ name = libpipewire-module-client-node }}
  {{ name = libpipewire-module-adapter }}
  {{ name = libpipewire-module-echo-cancel args = {{
      library.name = aec/libspa-aec-webrtc
      monitor.mode = true
      aec.args = {{ {AEC_ARGS} }}
      capture.props = {{ node.name = {self.names["capture"]} media.class = Stream/Input/Audio/Internal node.autoconnect = false {hidden} }}
      sink.props    = {{ node.name = {self.names["ref"]} media.class = Stream/Input/Audio/Internal node.autoconnect = false {hidden} }}
      source.props  = {{ node.name = {self.names["source"]} media.class = Audio/Source/Internal {hidden} }}
  }} }}
]
""")
        self.proc = await asyncio.create_subprocess_exec(
            "pipewire", "-c", self.conf, stdin=asyncio.subprocess.DEVNULL,
            stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL)
        ids = {}
        for _ in range(50):
            nodes, _links = await pw_graph()
            ids = {k: next((i for i, p in nodes.items() if p.get("node.name") == name), None)
                   for k, name in self.names.items()}
            if all(ids.values()):
                break
            await asyncio.sleep(0.1)
        if not all(ids.values()):
            await self.stop()
            return False
        # mic -> canceller; output's monitor (what the speakers play) -> reference
        await rec._link(self.mic_node, ids["capture"], ("FL", "FR"))
        refs = route_ports(await monitor_ports(self.spk_node),
                           (await node_ports()).get(ids["ref"], {}).get("input", []), "FL", "FR")
        for o, i in refs:
            await run("pw-link", str(o), str(i))
        self.source = ids["source"]
        return True

    async def stop(self):
        if self.proc and self.proc.returncode is None:
            self.proc.terminate()
            try:
                await asyncio.wait_for(self.proc.wait(), 5)
            except asyncio.TimeoutError:
                self.proc.kill()
        try:
            os.remove(self.conf)
        except OSError:
            pass


# ------------------------------------------------------------------ level meters

class Meter:
    """RMS level of one stream: a hidden pw-record capture linked to its outputs."""
    serial = itertools.count(1)

    def __init__(self, rec, item):
        self.rec, self.node_of = rec, item.stream.node
        self.name = f"grab_meter_{item.id}_{next(Meter.serial)}"
        self.proc, self.links = None, []
        self._level, self._at = 0.0, -1.0
        self.task = asyncio.get_running_loop().create_task(self._run())

    def level(self, now):
        return round(self._level, 3) if now - self._at < 0.3 else 0.0

    async def _run(self):
        props = (f"{{ node.name = {self.name} node.autoconnect = false "
                 "media.class = Stream/Input/Audio/Internal media.name = \"Grab level meter\" "
                 "application.name = Grab state.restore-props = false state.restore-target = false }")
        try:
            self.proc = await asyncio.create_subprocess_exec(
                "pw-record", "--raw", "--rate", str(METER_RATE), "--channels", "2", "--format", "s16",
                "--latency", f"{1000 // METER_FPS}ms", "-P", props, "-",
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
                stdin=asyncio.subprocess.DEVNULL)
            node = None
            for _ in range(25):
                nodes, _links = await pw_graph()
                node = next((i for i, p in nodes.items() if p.get("node.name") == self.name), None)
                if node:
                    break
                await asyncio.sleep(0.1)
            if node:
                self.links = await self.rec._link(self.node_of, node, ("FL", "FR"))
            chunk = METER_RATE // METER_FPS * 4           # s16 stereo
            loop = asyncio.get_running_loop()
            while True:
                data = await self.proc.stdout.readexactly(chunk)
                a = array.array("h", data)
                self._level = math.sqrt(sum(x * x for x in a) / len(a)) / 32768
                self._at = loop.time()
        except (asyncio.IncompleteReadError, asyncio.CancelledError):
            pass
        finally:
            if self.proc and self.proc.returncode is None:
                self.proc.terminate()
                try:
                    await asyncio.wait_for(self.proc.wait(), 2)
                except (asyncio.TimeoutError, asyncio.CancelledError):
                    self.proc.kill()

    def stop(self):
        self.task.cancel()


# ------------------------------------------------------------------ the recorder

class Recorder:
    def __init__(self):
        self.items = {}                    # id -> Item, display order
        self.by_stream = {}                # sink-input index -> Item
        self.sources = []                  # [(name, description, node)]
        self.default_source = ""
        self.counter = itertools.count(1)
        self.iface = None
        self.queue = EncodeQueue(self.encoded, self.tags_for)
        self.stopping = False
        self.players = None                # Players, once the bus is up
        self.silent_module = None          # grab_silent, while any playback is muted
        self.meters = {}                   # item -> Meter, while meters are on
        self.aecs = {}                     # (input node, output node) -> Aec
        self.default_sink = ""
        self.meters_until = 0.0            # Meters() lease
        self.meter_task = None
        self._emit = None
        self._timers = {}

    def later(self, key, coro_fn, delay=0.15):
        """Run coro_fn after delay; a newer request for the same key replaces it."""
        loop = asyncio.get_running_loop()
        if key in self._timers:
            self._timers[key].cancel()
        self._timers[key] = loop.call_later(delay, lambda: loop.create_task(coro_fn()))

    # ---- change notification (coalesced)

    def changed(self):
        if self.iface and not self._emit:
            loop = asyncio.get_running_loop()
            self._emit = loop.call_later(0.05, self._do_emit)

    def _do_emit(self):
        self._emit = None
        self.iface.ItemsChanged()
        self.iface.StateChanged()

    def state_json(self):
        items = [{k: v.value for k, v in i.props(self.input_description(i.input)).items()}
                 for i in self.items.values()]
        inputs = [{"name": n, "description": d, "default": is_def}
                  for n, d, is_def in self.input_list()]
        return json.dumps({"items": items, "inputs": inputs, "folder": SETTINGS.outdir}, ensure_ascii=False)

    def item_list(self):
        return [[i.id, i.props(self.input_description(i.input))] for i in self.items.values()]

    def input_list(self):
        return [[n, d, n == self.default_source] for n, d, _node in self.sources]

    def tags_for(self, item):
        """Metadata for an item's files: title, app, start time, input."""
        inp = item.input_desc or (self.input_description(item.input) if item.input else "")
        return {"title": item.title, "app": item.app, "started": item.started, "input": inp}

    def input_description(self, inp):
        if inp == "default":
            desc = next((d for n, d, _ in self.sources if n == self.default_source), "")
            return f"Default ({desc})" if desc else "Default"
        if inp:
            return next((d for n, d, _ in self.sources if n == inp), inp)
        return "None"

    # ---- streams

    async def refresh_streams(self):
        if self.stopping:
            return
        title_for = self.players.title_for if self.players else (lambda pid: "")
        streams = {si["index"]: Stream(si, title_for(Stream.pid(si)))
                   for si in await pactl_json("sink-inputs") if Stream.accept(si)}

        for idx, item in list(self.by_stream.items()):
            s = streams.get(idx)
            if s is None or (item.state == "available" and not s.offerable
                             and not item.muted and not item.pending):
                del self.by_stream[idx]
                item.stream = None
                if item.muted:             # gone while muted: nothing to restore
                    item.muted, item.silent_links, item.playback_node = False, [], None
                    asyncio.get_running_loop().create_task(self._drop_silent_sink())
                if item.state == "available" and not item.pending:
                    self.items.pop(item.id, None)  # (starting: toggle() decides)
                elif item.state in ACTIVE:
                    self._lose(item)
            else:
                item.stream = s
                if item.state == "available" or s.has_title:
                    item.title, item.app = s.title, s.app

        for idx, s in streams.items():
            if idx not in self.by_stream and s.offerable:
                item = Item(s)
                self.items[item.id] = item
                self.by_stream[idx] = item
        self._adopt_replacements()
        self.changed()

    def _lose(self, item):
        """A recording's stream is gone: keep recording (silence, which isn't
        saved) for STREAM_GRACE seconds in case a replacement appears (see
        _adopt_replacements); then finalize."""
        if item.lost:
            return
        item.lost = True
        loop = asyncio.get_running_loop()

        def timeout():
            if item.lost and item.stream is None and item.state in ACTIVE:
                loop.create_task(self.finalize(item))
        loop.call_later(STREAM_GRACE, timeout)

    def _adopt_replacements(self):
        """Give each lost recording the stream that replaced its old one: a
        new stream (offered as an available item) of the same process with
        the same title. Its item goes; the recording continues in the same
        file."""
        for item in list(self.items.values()):
            if not (item.lost and item.stream is None and item.state in ACTIVE):
                continue
            new = next((c for c in self.items.values()
                        if c.state == "available" and c.stream and not c.pending
                        and not c.muted and c.stream.process == item.process
                        and c.stream.app == item.app and c.stream.title == item.title), None)
            if not new:
                continue
            s = new.stream
            print(f"grabd: {item.title!r}: following its new stream {s.idx}", flush=True)
            self.items.pop(new.id, None)
            self.by_stream[s.idx] = item
            item.stream, item.lost = s, False
            asyncio.get_running_loop().create_task(self._relink_stream(item))

    async def _relink_stream(self, item):
        """Link the item's (new) stream into its recording sink if it is
        recording; a paused one is linked when resumed."""
        async with item.op:
            if item.state == "recording" and item.stream:
                await self._unlink(item.stream_links)
                item.stream_links = await self._link(item.stream.node, item.sink_node, STREAM_CH)
                self.changed()

    # ---- inputs

    async def refresh_inputs(self):
        rc, out = await run("pactl", "get-default-source")
        default = out.strip()
        sources = []
        for src in await pactl_json("sources"):
            p = src.get("properties", {})
            name = src.get("name", "")
            if name.endswith(".monitor") or p.get("device.class") == "monitor":
                continue
            sources.append((name, src.get("description") or name, str(p.get("object.id"))))
        default_changed = default != self.default_source
        if sources != self.sources or default_changed:
            self.sources, self.default_source = sources, default
            if self.iface:
                self.iface.InputsChanged()
            await self._relink_inputs()
            self.changed()
        elif any(i.aec for i in self.items.values()):
            await self._relink_inputs()        # the default output may have changed

    async def _relink_inputs(self):
        """Relink recording inputs whose source, or echo reference, changed."""
        spk = await self._output_node() if any(i.aec for i in self.items.values()) else None
        for item in list(self.items.values()):
            if item.state != "recording" or not item.input:
                continue
            stale_aec = item.aec and spk and item.aec.spk_node != str(spk)
            if self._source_node(item.input) != item.input_node or stale_aec:
                async with item.op:
                    if item.state == "recording":
                        await self._link_input(item)

    def _source_node(self, inp):
        name = self.default_source if inp == "default" else inp
        return next((node for n, _d, node in self.sources if n == name), None)

    # ---- PipeWire plumbing

    async def _sink_node(self, name):
        for _ in range(25):
            for s in await pactl_json("sinks"):
                if s.get("name") == name:
                    return str(s.get("properties", {}).get("object.id"))
            await asyncio.sleep(0.2)
        return None

    async def _link(self, src, dst, channels):
        """Link node src's outputs into dst's input channels (left, right)."""
        for _ in range(25):
            ports = await node_ports()
            outs = ports.get(src, {}).get("output", [])
            ins = ports.get(dst, {}).get("input", [])
            if outs and ins:
                pairs = route_ports(outs, ins, *channels)
                for o, i in pairs:
                    await run("pw-link", str(o), str(i))
                return pairs
            await asyncio.sleep(0.2)
        return []

    async def _unlink(self, pairs):
        for o, i in pairs:
            await run("pw-link", "-d", str(o), str(i))
        pairs.clear()

    async def _link_input(self, item):
        """(Re)link the item's input source into its sink's input channels,
        through the echo canceller if it's on."""
        await self._unlink_input(item)
        src = self._source_node(item.input) if item.input else None
        if not (src and item.sink_node):
            return
        feed = src
        if item.echo_cancel:
            aec = await self._aec_for(src)
            if aec:
                aec.users.add(item)
                item.aec, feed = aec, aec.source
        item.input_links = await self._link(feed, item.sink_node, INPUT_CH)
        if item.input_links:
            item.input_node = src

    async def _unlink_input(self, item):
        await self._unlink(item.input_links)
        item.input_node = None
        if item.aec:
            aec, item.aec = item.aec, None
            aec.users.discard(item)
            if not aec.users:
                self.aecs.pop((aec.mic_node, aec.spk_node), None)
                await aec.stop()

    async def _output_node(self):
        """Node id of the default output (the echo reference)."""
        rc, out = await run("pactl", "get-default-sink")
        self.default_sink = out.strip()
        nodes, _links = await pw_graph()
        return next((i for i, p in nodes.items() if p.get("node.name") == self.default_sink), None)

    async def _aec_for(self, mic_node):
        spk = await self._output_node()
        if not spk:
            return None
        key = (str(mic_node), str(spk))
        aec = self.aecs.get(key)
        if not aec:
            aec = Aec(*key)
            if not await aec.start(self):
                return None
            self.aecs[key] = aec
        return aec

    async def set_echo_cancel(self, item, on):
        async with item.op:
            if item.echo_cancel == on:
                return
            item.echo_cancel = on
            if item.state == "recording" and item.input:
                await self._link_input(item)
            self.changed()

    async def _load_sink(self, name, description):
        rc, out = await run(
            "pactl", "load-module", "module-null-sink",
            f"sink_name={name}", "channels=4", f"channel_map={SINK_MAP}",
            f"sink_properties='node.virtual=true device.description=\"{description}\" "
            # a new sink per recording: don't let WirePlumber remember each one
            "device.icon_name=\"media-record\" state.restore-props=false'")
        return out.strip() if rc == 0 else None

    # ---- actions

    def request_toggle(self, item):
        """Start a toggle unless one is already in progress (e.g. a double click,
        which would otherwise pause right after starting). Marked synchronously,
        before any await, so back-to-back calls can't both get through."""
        if item.pending:
            return
        item.pending = True
        self.changed()
        asyncio.get_running_loop().create_task(self.toggle(item))

    async def toggle(self, item):
        try:
            async with item.op:
                if item.state == "available" and item.stream:
                    await self._start(item)
                elif item.state == "recording":
                    await self._unlink(item.stream_links)
                    await self._unlink_input(item)
                    item.state = "paused"
                    self.changed()
                    asyncio.get_running_loop().call_later(
                        SAVE_DELAY, lambda: (self.queue.request(item), self.changed()))
                elif item.state == "paused" and item.stream:
                    item.stream_links = await self._link(item.stream.node, item.sink_node,
                                                         STREAM_CH)
                    await self._link_input(item)
                    item.state = "recording"
                    self.changed()
        finally:
            item.pending = False
            # the stream went away meanwhile (e.g. while the recording started):
            # end what was started, or drop the entry
            if item.stream is None and self.items.get(item.id) is item:
                if item.state in ACTIVE:
                    self._lose(item)
                    self._adopt_replacements()
                elif item.state == "available":
                    self.items.pop(item.id, None)
            self.changed()

    async def _start(self, item):
        s = item.stream
        item.error = ""
        item.sink = f"grab_{s.idx}_{next(self.counter)}"
        now = time.localtime()
        item.started = time.strftime("%Y-%m-%dT%H:%M:%S", now)
        item.recorded = True
        item.flac, item.mp3 = self._new_paths(
            f"{time.strftime('%Y-%m-%d_%H-%M-%S', now)}_{fname(item.title)}")
        item.module = await self._load_sink(item.sink, "Grab")
        if not item.module:
            item.error = "could not create sink"
            self.changed()
            return
        item.sink_node = await self._sink_node(item.sink)
        item.proc_stopping = item.ffmpeg_died = False
        item.proc = await asyncio.create_subprocess_exec(
            "ffmpeg", "-nostdin", "-loglevel", "error",
            "-f", "pulse", "-channels", "4", "-name", "Grab", "-stream_name", f"Grab: {item.title}",
            "-i", f"{item.sink}.monitor",
            "-filter_complex", MIX, *tag_args(self.tags_for(item)),
            "-c:a", "flac", "-flush_packets", "1", item.flac,
            stdin=asyncio.subprocess.DEVNULL, env=FFMPEG_ENV)
        asyncio.get_running_loop().create_task(self._watch_ffmpeg(item, item.proc))
        item.stream_links = (await self._link(s.node, item.sink_node, STREAM_CH)
                             if item.sink_node else [])
        if not item.stream_links:
            item.error = "could not connect to the stream"
            await self._teardown(item)
            if os.path.exists(item.flac):
                os.remove(item.flac)
            item.flac = item.mp3 = ""
            self.changed()
            return
        await self._link_input(item)
        if item.proc.returncode is not None:   # it failed right away (no await from
            item.error = f"could not start recording: ffmpeg exited ({item.proc.returncode})"
            await self._teardown(item)         # here to the state change: the watcher
            if os.path.exists(item.flac):      # sees either this or "recording")
                os.remove(item.flac)
            item.flac = item.mp3 = ""
            self.changed()
            return
        item.state = "recording"
        self.changed()

    def _new_paths(self, base):
        """(FLAC, MP3) paths for a new recording that no file or other item
        uses: the same title started twice in a second gets "base (2)"."""
        taken = {p for i in self.items.values() for p in (i.flac, i.mp3, i.file) if p}
        for n in itertools.count(1):
            name = base if n == 1 else f"{base} ({n})"
            flac = os.path.join(SETTINGS.outdir, f".{name}.flac")
            mp3 = os.path.join(SETTINGS.outdir, f"{name}.mp3")
            if not any(p in taken or os.path.lexists(p) for p in (flac, mp3)):
                return flac, mp3

    async def _watch_ffmpeg(self, item, proc):
        """End the recording if its ffmpeg exits on its own (disk full, a
        file it can't write, ...): otherwise it would look like it's still
        recording."""
        rc = await proc.wait()
        if item.proc is not proc or item.proc_stopping or self.stopping:
            return
        print(f"grabd: ffmpeg for {item.flac} exited with {rc}", flush=True)
        item.error = f"recording stopped: ffmpeg exited ({rc})"
        item.ffmpeg_died = True
        if item.state in ACTIVE:
            async with item.op:
                if item.state in ACTIVE:
                    self._detach_stream(item)
            await self.finalize(item)
        else:
            self.changed()             # still starting: _start sees the error

    def _detach_stream(self, item):
        """Offer the item's stream again as a new item, so it can be recorded
        again while the item keeps what was recorded. The new item takes over
        the stream's settings: input, echo cancellation and muted playback."""
        s = item.stream
        if not s or self.by_stream.get(s.idx) is not item:
            return
        new = Item(s)
        new.input, new.echo_cancel = item.input, item.echo_cancel
        new.muted, new.silent_links, new.playback_node = \
            item.muted, item.silent_links, item.playback_node
        item.muted, item.silent_links, item.playback_node = False, [], None
        item.stream = None
        self.items[new.id] = new
        self.by_stream[s.idx] = new
        self.changed()

    async def set_input(self, item, inp):
        async with item.op:
            item.input = inp
            if item.state == "recording":
                await self._link_input(item)
            self.changed()

    async def _teardown(self, item):
        item.proc_stopping = True          # first: ffmpeg exiting from here on is us
        await self._unlink(item.stream_links)
        await self._unlink_input(item)
        if item.proc and item.proc.returncode is None:
            item.proc.send_signal(signal.SIGINT)          # ffmpeg finalizes the FLAC
            try:
                await asyncio.wait_for(item.proc.wait(), 15)
            except asyncio.TimeoutError:
                item.proc.kill()
        if item.module:
            await run("pactl", "unload-module", item.module)
            item.module = None

    async def finalize(self, item):
        async with item.op:
            if item.state not in ACTIVE:
                return
            item.state = "encoding"
            self.changed()
            await self._teardown(item)
            self.queue.request(item, final=True)
            self.changed()

    async def remove(self, item, with_data=False, permanently=False):
        async with item.op:
            if item.state not in FINISHED or self.items.get(item.id) is not item:
                return
            mp3 = item.file or item.mp3
            if with_data:
                paths = list(dict.fromkeys(p for p in (mp3, item.flac) if p and os.path.exists(p)))
                error = await discard(paths, permanently)
                if error:
                    item.error = error
                    self.changed()
                    return
            else:
                if mp3 and os.path.exists(mp3) and not await unmark(mp3):
                    item.error = "could not update the MP3's tags"
                    self.changed()
                    return
                if item.flac and os.path.exists(item.flac):
                    error = self._unhide(item)
                    if error:
                        item.error = error
                        self.changed()
                        return
            self.items.pop(item.id, None)
            self.changed()

    def _unhide(self, item):
        """Keep a failed recording's FLAC (the only copy) as a visible file,
        so it isn't taken for a crashed recording at the next start."""
        base = os.path.basename(item.flac)[1:-5]
        for n in itertools.count(1):
            name = base if n == 1 else f"{base} ({n})"
            path = os.path.join(os.path.dirname(item.flac), name + ".flac")
            if not os.path.lexists(path):
                break
        try:
            os.rename(item.flac, path)
        except OSError as e:
            return f"could not keep the FLAC: {e.strerror}"
        print(f"grabd: kept {path}", flush=True)
        return ""

    async def remove_finished(self, with_data=False, permanently=False):
        for item in list(self.items.values()):
            await self.remove(item, with_data, permanently)

    # ---- level meters

    def keep_meters(self, on):
        loop = asyncio.get_running_loop()
        self.meters_until = loop.time() + METER_LEASE if on else 0.0
        if on and not self.meter_task:
            self.meter_task = loop.create_task(self._meter_loop())

    async def _meter_loop(self):
        loop = asyncio.get_running_loop()
        try:
            while loop.time() < self.meters_until and not self.stopping:
                wanted = {i for i in self.items.values() if i.stream and i.state not in FINISHED}
                for item in list(self.meters):
                    if item not in wanted or self.meters[item].node_of != item.stream.node:
                        self.meters.pop(item).stop()
                for item in wanted - set(self.meters):
                    self.meters[item] = Meter(self, item)
                now = loop.time()
                self.iface.Levels({i.id: m.level(now) for i, m in self.meters.items()})
                await asyncio.sleep(1 / METER_FPS)
        finally:
            for m in self.meters.values():
                m.stop()
            self.meters.clear()
            self.meter_task = None
            if self.iface:
                self.iface.Levels({})

    # ---- muted playback

    async def _silent_sink(self):
        """Node id of grab_silent, loading it if needed."""
        if not self.silent_module:
            rc, out = await run(
                "pactl", "load-module", "module-null-sink", "sink_name=grab_silent", "channels=2",
                "sink_properties='node.virtual=true device.description=\"Grab (muted playback)\" "
                "device.icon_name=\"audio-volume-muted\" state.restore-props=false'")
            if rc != 0:
                return None
            self.silent_module = out.strip()
        return await self._sink_node("grab_silent")

    async def _drop_silent_sink(self):
        if self.silent_module and not any(i.muted for i in self.items.values()):
            await run("pactl", "unload-module", self.silent_module)
            self.silent_module = None

    async def set_playback_muted(self, item, muted):
        async with item.op:
            s = item.stream
            if not s or item.muted == muted or self.items.get(item.id) is not item:
                return
            item.error = ""
            if muted:
                silent = await self._silent_sink()
                item.silent_links = await self._link(s.node, silent, ("FL", "FR")) if silent else []
                if not item.silent_links:
                    item.error = "could not mute playback"
                else:
                    # cut the links to the playback device only: not ours (grab_*
                    # sinks) nor other consumers of the stream (level meters, ...)
                    nodes, links = await pw_graph()
                    item.playback_node = None
                    for onode, oport, inode, iport in links:
                        p = nodes.get(inode, {})
                        if (onode == str(s.node) and p.get("media.class", "").startswith("Audio/Sink")
                                and not p.get("node.name", "").startswith("grab_")):
                            item.playback_node = inode
                            await run("pw-link", "-d", oport, iport)
                    item.muted = True
            else:
                await self._restore_playback(s.node, item.silent_links, item.playback_node)
                item.muted, item.silent_links, item.playback_node = False, [], None
            self.changed()
        if not muted:
            await self._drop_silent_sink()

    async def _restore_playback(self, stream_node, silent_links, device=None):
        """Undo a mute: WirePlumber still thinks the stream is linked to its old
        device, so setting the target to that device does nothing. Point it at
        the silent sink (WirePlumber moves it), then at the device (or the
        default output), then put the target metadata back as it was."""
        stream_node = str(stream_node)
        orig = await stream_target(stream_node)
        await self._unlink(silent_links)
        nodes, _links = await pw_graph()
        serial = lambda name: next((p.get("object.serial") for p in nodes.values()
                                    if p.get("node.name") == name), None)
        if device not in nodes:
            rc, out = await run("pactl", "get-default-sink")
            device = next((i for i, p in nodes.items() if p.get("node.name") == out.strip()), None)
        silent, back = serial("grab_silent"), orig or (nodes[device].get("object.serial") if device else None)
        for value in (silent, back):
            if value:
                await run("pw-metadata", "-n", "default", stream_node, "target.object", str(value), "Spa:Id")
                await asyncio.sleep(0.3)
        if orig is None:
            await run("pw-metadata", "-n", "default", "-d", stream_node, "target.object")

        # Make sure it plays again before grab_silent can go: a stream left without
        # links is never run, and can stall its app's other streams (seen with a
        # paused Firefox stream, where WirePlumber didn't move it back).
        for _ in range(30):
            if await self._playback_device(stream_node):
                return
            await asyncio.sleep(0.1)
        nodes, _links = await pw_graph()
        target = next((i for i, p in nodes.items() if str(p.get("object.serial")) == str(back)), device)
        if target:
            print(f"grabd: stream {stream_node} not relinked by WirePlumber; linking it to "
                  f"{nodes.get(target, {}).get('node.name')}", flush=True)
            await self._link(stream_node, target, ("FL", "FR"))

    async def _playback_device(self, stream_node):
        """The playback device a stream is linked to (not grab's own sinks), or None."""
        nodes, links = await pw_graph()
        for onode, _oport, inode, _iport in links:
            p = nodes.get(inode, {})
            if (onode == str(stream_node) and p.get("media.class", "").startswith("Audio/Sink")
                    and not p.get("node.name", "").startswith("grab_")):
                return inode
        return None

    def save_now(self, item):
        if item.state in ACTIVE and item.flac:
            self.queue.request(item)
            self.changed()

    async def remove_record(self, item, permanently=False):
        async with item.op:
            if item.state not in ACTIVE or self.items.get(item.id) is not item:
                return
            item.pending = True            # no Toggle meanwhile
            self.changed()
            try:
                await self._teardown(item)
                # let a snapshot of this item finish (or drop a queued one), so no
                # encode writes the MP3 again after it was removed
                self.queue.pending.pop(item, None)
                while self.queue.current is item:
                    await asyncio.sleep(0.1)
                item.busy = False
                mp3 = item.mp3
                paths = [p for p in (mp3, item.flac) if p and os.path.exists(p)]
                item.error = await discard(paths, permanently)
                item.flac = item.mp3 = item.file = item.started = ""
                item.duration = 0.0
                item.sink, item.sink_node, item.proc = "", None, None
                if item.stream:
                    item.state = "available"
                else:                      # the stream is gone too: nothing left to show
                    self.items.pop(item.id, None)
            finally:
                item.pending = False
                self.changed()

    # ---- files in the recordings folder

    async def scan_files(self):
        """List MP3s that carry our marker and belong to no item as done items;
        drop done items whose MP3 is gone or lost the marker. After the folder
        setting changed, items found in the old folder go; recordings made by
        this grabd stay while their MP3 is there."""
        if self.stopping:
            return
        outdir = SETTINGS.outdir
        try:
            names = os.listdir(outdir)
        except OSError:
            return                         # don't take an unreadable folder for an empty one
        present = sorted(os.path.join(outdir, n) for n in names
                         if n.endswith(".mp3") and not n.startswith("."))
        metas = {}
        for path in present:               # ffprobe only for new or changed files
            meta = await read_tags(path)
            if meta is not None:
                metas[path] = meta
        kept = set(present) | {i.file for i in self.items.values() if i.recorded}
        for path in [p for p in _tag_cache if p not in kept]:
            del _tag_cache[path]
        changed = False

        for item in list(self.items.values()):
            if item.state != "done" or item.file in metas:
                continue
            if item.recorded and os.path.dirname(item.file) != outdir \
                    and await read_tags(item.file) is not None:
                continue                   # recorded here into an earlier folder
            self.items.pop(item.id, None)
            changed = True

        owned = {p for i in self.items.values() for p in (i.mp3, i.file) if p}
        for path, meta in metas.items():
            if path in owned:
                continue
            title = meta["title"] or re.sub(TIMESTAMP_RE, "", os.path.basename(path)[:-4])
            item = Item(title=title or "audio", app=meta["app"])
            item.state, item.file, item.mp3 = "done", path, path
            item.started, item.duration = meta["started"], meta["duration"]
            self.items[item.id] = item
            changed = True
        if changed:
            self.changed()

    # ---- encode results

    async def encoded(self, item, final, ok, saved, sec):
        if saved:                          # (tagged by the encode)
            item.file, item.duration = item.mp3, sec
        if not ok:
            item.error = "encoding failed; FLAC kept"
        if final:
            if ok and os.path.exists(item.flac):
                os.remove(item.flac)
            if not ok or (item.ffmpeg_died and not item.file):   # say why
                item.state = "failed"
            else:
                item.state = "done" if item.file else "empty"
        self.changed()

    # ---- startup / shutdown

    async def cleanup_leftovers(self):
        # streams a previous grabd left muted would stall once grab_silent goes
        nodes, links = await pw_graph()
        silent = next((i for i, p in nodes.items() if p.get("node.name") == "grab_silent"), None)
        if silent:
            muted = {}
            for onode, oport, inode, iport in links:
                if inode == silent:
                    muted.setdefault(onode, []).append((oport, iport))
            for stream_node, pairs in muted.items():
                await self._restore_playback(stream_node, pairs)
        rc, out = await run("pactl", "list", "short", "modules")
        for line in out.splitlines():
            if "module-null-sink" in line and re.search(r"sink_name=grab_(\d|silent\b)", line):
                await run("pactl", "unload-module", line.split()[0])

    async def recover_orphans(self):
        for flac in sorted(glob.glob(os.path.join(SETTINGS.outdir, ".*.flac"))):
            base = os.path.basename(flac)[1:-5]
            mp3 = os.path.join(SETTINGS.outdir, base + ".mp3")
            # tagged when recording started; older ones: from a pause snapshot
            meta = await read_tags(flac) or await read_tags(mp3) or {}
            title = base.split("_", 2)[2] if base.count("_") >= 2 else base
            item = Item(title=meta.get("title") or title, app=meta.get("app", ""))
            m = re.match(r"(\d{4}-\d\d-\d\d)_(\d\d)-(\d\d)-(\d\d)_", base)
            item.started = meta.get("started") or (f"{m[1]}T{m[2]}:{m[3]}:{m[4]}" if m else "")
            item.input_desc = meta.get("input", "")
            item.flac, item.mp3 = flac, mp3
            item.recorded = True
            item.state = "encoding"
            self.items[item.id] = item
            self.queue.request(item, final=True)

    def idle(self):
        """Nothing a restart would interrupt: no recording (paused counts), no
        encoding, no Toggle in progress, no muted playback."""
        return not any(i.state in ACTIVE or i.state == "encoding" or i.busy or i.pending
                       or i.muted for i in self.items.values())

    async def shutdown(self):
        if self.stopping:
            return
        self.stopping = True
        self.meters_until = 0.0
        for item in [i for i in self.items.values() if i.muted]:
            await self.set_playback_muted(item, False)
        await asyncio.gather(*(self.finalize(i) for i in list(self.items.values())
                               if i.state in ACTIVE), return_exceptions=True)
        await self.queue.drain()
        for aec in list(self.aecs.values()):
            await aec.stop()
        self.aecs.clear()


# ------------------------------------------------------------------ D-Bus interface

class RecorderInterface(ServiceInterface):
    def __init__(self, rec):
        super().__init__(IFACE)
        self.rec = rec

    def _item(self, item_id):
        return self.rec.items.get(item_id)

    def _spawn(self, coro):
        asyncio.get_running_loop().create_task(coro)

    @method()
    def GetSettings(self) -> "s":
        return json.dumps(SETTINGS.as_dict(), ensure_ascii=False)

    @method()
    def SetSettings(self, changes: "s"):
        try:
            values = json.loads(changes)
            if not isinstance(values, dict):
                raise SettingsError("expected a JSON object")
            SETTINGS.update(values)
        except ValueError:
            raise DBusError("org.grab.Recorder1.Error.InvalidSettings", "settings: invalid JSON")
        except SettingsError as e:
            raise DBusError("org.grab.Recorder1.Error.InvalidSettings", str(e))
        except OSError as e:
            raise DBusError("org.grab.Recorder1.Error.Failed", f"can't save settings: {e}")
        print(f"grabd: settings: {SETTINGS.values}", flush=True)
        self.SettingsChanged()
        self.rec.changed()
        self._spawn(self.rec.scan_files())

    @dbus_signal()
    def SettingsChanged(self) -> "s":
        return json.dumps(SETTINGS.as_dict(), ensure_ascii=False)

    @method()
    def ListItems(self) -> "a(sa{sv})":
        return self.rec.item_list()

    @method()
    def ListInputs(self) -> "a(ssb)":
        return self.rec.input_list()

    @method()
    def Toggle(self, item_id: "s"):
        item = self._item(item_id)
        if item:
            self.rec.request_toggle(item)

    @method()
    def SetInput(self, item_id: "s", input_name: "s"):
        item = self._item(item_id)
        if item and item.state not in FINISHED and item.state != "encoding":
            self._spawn(self.rec.set_input(item, input_name))

    @method()
    def Remove(self, item_id: "s", with_data: "b"):
        item = self._item(item_id)
        if item:
            self._spawn(self.rec.remove(item, with_data))

    @method()
    def Delete(self, item_id: "s"):
        item = self._item(item_id)
        if item:
            self._spawn(self.rec.remove(item, True, permanently=True))

    @method()
    def RemoveFinished(self, with_data: "b"):
        self._spawn(self.rec.remove_finished(with_data))

    @method()
    def DeleteFinished(self):
        self._spawn(self.rec.remove_finished(True, permanently=True))

    @method()
    def SaveNow(self, item_id: "s"):
        item = self._item(item_id)
        if item:
            self.rec.save_now(item)

    @method()
    def SetEchoCancel(self, item_id: "s", on: "b"):
        item = self._item(item_id)
        if item and item.state not in FINISHED and item.state != "encoding":
            self._spawn(self.rec.set_echo_cancel(item, on))

    @method()
    def Meters(self, on: "b"):
        self.rec.keep_meters(on)

    @dbus_signal()
    def Levels(self, levels) -> "s":
        return json.dumps(levels)

    @method()
    def SetPlaybackMuted(self, item_id: "s", muted: "b"):
        item = self._item(item_id)
        if item:
            self._spawn(self.rec.set_playback_muted(item, muted))

    @method()
    def RemoveRecord(self, item_id: "s"):
        item = self._item(item_id)
        if item:
            self._spawn(self.rec.remove_record(item))

    @method()
    def DeleteRecord(self, item_id: "s"):
        item = self._item(item_id)
        if item:
            self._spawn(self.rec.remove_record(item, permanently=True))

    @dbus_signal()
    def ItemsChanged(self) -> "a(sa{sv})":
        return self.rec.item_list()

    @dbus_signal()
    def InputsChanged(self) -> "a(ssb)":
        return self.rec.input_list()

    @method()
    def GetState(self) -> "s":
        return self.rec.state_json()

    @dbus_signal()
    def StateChanged(self) -> "s":
        return self.rec.state_json()


# ------------------------------------------------------------------ main

async def subscribe(rec):
    while True:
        proc = await asyncio.create_subprocess_exec(
            "pactl", "subscribe", stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL)
        try:
            async for raw in proc.stdout:
                if b"on sink-input #" in raw:
                    rec.later("streams", rec.refresh_streams)
                elif b"on source #" in raw or b"on server" in raw:
                    rec.later("inputs", rec.refresh_inputs)
        finally:
            if proc.returncode is None:
                proc.kill()
                await proc.wait()
        await asyncio.sleep(2)              # pactl ended (e.g. PipeWire restart)
        await rec.refresh_inputs()
        await rec.refresh_streams()


async def scan_loop(rec):
    while True:
        try:
            await rec.scan_files()
        except Exception as e:             # try again next time
            print(f"grabd: scanning {SETTINGS.outdir} failed: {e!r}", flush=True)
        await asyncio.sleep(SCAN_INTERVAL)


def file_id(path):
    try:
        st = os.stat(path)
    except OSError:
        return None
    return (st.st_dev, st.st_ino, st.st_mtime_ns)


async def update_loop(rec, restart):
    """When grabd's own file is replaced (a package upgrade), wait until
    nothing is being recorded and then restart into the new version."""
    path = os.path.realpath(__file__)
    running = file_id(path)
    noted = False
    while True:
        await asyncio.sleep(UPDATE_CHECK_INTERVAL)
        now = file_id(path)
        if now is None or now == running:
            continue
        if not noted:
            print(f"grabd: {path} was updated; restarting when nothing is recording", flush=True)
            noted = True
        if rec.idle():
            print("grabd: restarting into the updated version", flush=True)
            restart()
            return


async def main():
    try:
        os.makedirs(SETTINGS.outdir, exist_ok=True)
    except OSError as e:
        print(f"grabd: can't create {SETTINGS.outdir}: {e}", flush=True)
    rec = Recorder()
    loop = asyncio.get_running_loop()
    worker = loop.create_task(rec.queue.worker())

    await rec.cleanup_leftovers()
    bus = await MessageBus(bus_type=BusType.SESSION).connect()
    rec.iface = RecorderInterface(rec)
    bus.export(OBJ_PATH, rec.iface)
    await bus.request_name(BUS_NAME)

    await rec.recover_orphans()
    rec.players = Players(bus, lambda: rec.later("streams", rec.refresh_streams))
    try:
        await rec.players.start()
    except Exception as e:
        print(f"grabd: MPRIS titles unavailable ({e})", flush=True)
    await rec.refresh_inputs()
    await rec.refresh_streams()

    stop = asyncio.Event()
    status = 0

    async def on_signal():
        await rec.shutdown()
        stop.set()

    def restart():
        nonlocal status
        status = EXIT_UPDATED
        loop.create_task(on_signal())

    for sig in (signal.SIGINT, signal.SIGTERM):
        loop.add_signal_handler(sig, lambda: loop.create_task(on_signal()))

    sub = loop.create_task(subscribe(rec))
    scan = loop.create_task(scan_loop(rec))
    update = loop.create_task(update_loop(rec, restart))
    await stop.wait()
    for t in (sub, scan, update, worker):
        t.cancel()
        try:
            await t
        except asyncio.CancelledError:
            pass
    bus.disconnect()
    return status


if __name__ == "__main__":
    sys.exit(asyncio.run(main()))
