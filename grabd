# The recording sink's channels: the stream in FL/FR, the input in FC/LFE (names
# don't matter on a hidden sink). This is the map ffmpeg's 4-channel pulse
# capture uses, so nothing is remixed on the way in.
SINK_MAP = "front-left,front-right,front-center,lfe"
