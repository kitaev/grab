def music_dir():
    """The XDG music folder (localized names, e.g. ~/Музыка), else ~/Music."""
    conf = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                        "user-dirs.dirs")
    try:
        for line in open(conf):
            m = re.match(r'\s*XDG_MUSIC_DIR="(.*)"', line)
            if m:
                path = m[1].replace("$HOME", os.path.expanduser("~"))
                if os.path.isabs(path) and os.path.normpath(path) != os.path.expanduser("~"):
                    return path
    except OSError:
        pass
    return os.path.expanduser("~/Music")


