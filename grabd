       f"[0:a]pan=stereo|c0=c2|c1=c3,"
       f"agate=threshold={10 ** (MIC_GATE_DB / 20):.6f}:range=0:attack=5:release=300[mic];"
       f"[stream][mic]amix=inputs=2:duration=longest:normalize=0,{AF}")
