post_install() {
    cat <<'MSG'
==> grab-recorder: the "Record What's Playing" widget shows up in the system
    tray after you log in again (or: systemctl --user restart plasma-plasmashell).
    If it doesn't, enable it in System Tray Settings > Entries.
    grabd starts by itself when the widget needs it; to start it at login:
        systemctl --user enable grabd
    Recordings go to the XDG music folder, in "grab" (e.g. ~/Music/grab).
MSG
}

post_upgrade() {
    cat <<'MSG'
==> grab-recorder: to use the new version now:
        systemctl --user daemon-reload
        systemctl --user restart grabd            # ends running recordings (saves them)
        systemctl --user restart plasma-plasmashell
MSG
}
